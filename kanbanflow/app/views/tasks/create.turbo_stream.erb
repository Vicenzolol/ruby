<%# Turbo Stream: após criar tarefa, insere o card na coluna correta e restaura o link "Adicionar" %>

<%# 1. Adiciona o card da nova tarefa no final da lista da coluna %>
<%= turbo_stream.append "#{@task.status}-tasks" do %>
  <%= render "tasks/task", task: @task %>
<% end %>

<%# 2. Restaura o link "+ Adicionar tarefa" no Turbo Frame da coluna (fecha o form) %>
<%= turbo_stream.update "new_task_#{@task.status}" do %>
  <%= link_to "+ Adicionar tarefa",
      new_project_task_path(@project, status: @task.status),
      class: "block text-center text-sm font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 py-2 rounded-md transition-colors" %>
<% end %>
