<%= form_with model: (@project ? [@project, task] : task), class: "space-y-5" do |f| %>
  <% if task.errors.any? %>
    <div class="alert-error">
      <p class="font-semibold mb-1">
        <%= pluralize(task.errors.count, "erro", "erros") %> impediram salvar a tarefa:
      </p>
      <ul class="list-disc list-inside space-y-0.5">
        <% task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Título da tarefa", class: "label" %>
    <%= f.text_field :title, placeholder: "Ex: Criar tela de login", class: "input" %>
  </div>

  <div>
    <%= f.label :description, "Descrição (opcional)", class: "label" %>
    <%= f.text_area :description, rows: 3, placeholder: "Detalhes da tarefa...", class: "textarea" %>
  </div>

  <div>
    <%= f.label :status, "Status", class: "label" %>
    <%= f.select :status,
        [["A Fazer", "todo"], ["Em Andamento", "in_progress"], ["Concluído", "done"]],
        {},
        class: "select" %>
  </div>

  <div class="pt-2">
    <%= f.submit task.new_record? ? "Criar Tarefa" : "Salvar Alterações", class: "btn btn-primary w-full" %>
  </div>
<% end %>
