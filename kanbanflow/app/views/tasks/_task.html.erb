<%
  status_styles = {
    "todo"        => "bg-gray-100 text-gray-600",
    "in_progress" => "bg-amber-100 text-amber-700",
    "done"        => "bg-green-100 text-green-700"
  }
  status_labels = {
    "todo"        => "A Fazer",
    "in_progress" => "Em Andamento",
    "done"        => "Concluído"
  }
%>
<div class="bg-gray-50 border border-gray-200 rounded-lg p-3 hover:shadow-sm transition-shadow">
  <div class="flex items-start justify-between gap-2">
    <p class="text-sm font-medium text-gray-800 leading-snug"><%= task.title %></p>
    <span class="text-xs px-2 py-0.5 rounded-full flex-shrink-0 <%= status_styles[task.status] %>">
      <%= status_labels[task.status] %>
    </span>
  </div>

  <% if task.description.present? %>
    <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= task.description %></p>
  <% end %>

  <div class="flex gap-2 mt-2 pt-2 border-t border-gray-200">
    <%= link_to "Editar", edit_task_path(task),
        class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium" %>
    <%= button_to "Excluir", task_path(task), method: :delete,
        data: { turbo_confirm: "Excluir esta tarefa?" },
        class: "text-xs text-red-500 hover:text-red-700 font-medium bg-transparent border-0 p-0 cursor-pointer" %>
  </div>
</div>
