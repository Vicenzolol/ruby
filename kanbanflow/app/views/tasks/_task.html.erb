<%
  status_styles = {
    "todo"        => "bg-blue-50 text-blue-600",
    "in_progress" => "bg-amber-100 text-amber-700",
    "done"        => "bg-emerald-100 text-emerald-700"
  }
  status_labels = {
    "todo"        => "A Fazer",
    "in_progress" => "Em Andamento",
    "done"        => "Concluído"
  }
  card_accent = {
    "todo"        => "kanban-card--todo",
    "in_progress" => "kanban-card--progress",
    "done"        => "kanban-card--done"
  }
%>
<div id="<%= dom_id(task) %>"
     class="kanban-card <%= card_accent[task.status] %>"
     data-task-id="<%= task.id %>"
     data-task-status="<%= task.status %>">
  <div class="flex items-start justify-between gap-2">
    <p class="text-sm font-semibold text-gray-900 leading-snug"><%= task.title %></p>
    <span class="text-xs px-2 py-0.5 rounded-full flex-shrink-0 font-medium <%= status_styles[task.status] %>">
      <%= status_labels[task.status] %>
    </span>
  </div>

  <% if task.description.present? %>
    <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= task.description %></p>
  <% end %>

  <div class="flex items-center gap-3 mt-2 pt-2 border-t border-gray-100">
    <%= link_to "Editar", edit_task_path(task),
        class: "text-xs text-blue-600 hover:text-blue-800 font-medium leading-none" %>
    <%= button_to "Excluir", task_path(task), method: :delete,
        data: { turbo_confirm: "Excluir esta tarefa?" },
        form: { class: "inline-flex items-center" },
        class: "text-xs text-red-500 hover:text-red-700 font-medium bg-transparent border-0 p-0 cursor-pointer leading-none" %>
  </div>
</div>
