<%# Turbo Frame: quando acessado via board, renderiza inline na coluna %>
<%= turbo_frame_tag "new_task_#{@task.status || params[:status]}" do %>
  <div class="card p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">Nova Tarefa</h3>
    <%= render "form", task: @task %>
    <%= link_to "Cancelar", @project,
        class: "block text-center text-xs text-gray-400 hover:text-gray-600 mt-2",
        data: { turbo_frame: "new_task_#{@task.status || params[:status]}" } %>
  </div>
<% end %>
