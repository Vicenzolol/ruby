<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Aprendendo e Fazendo Kanban" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Aprendendo e Fazendo Kanban">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-100 text-gray-900">
    <nav class="bg-gradient-to-r from-blue-800 to-indigo-900 shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-2">
            <span class="text-xl">📋</span>
            <%= link_to "KanbanFlow", root_path, class: "text-lg font-bold text-white hover:text-blue-200 transition-colors tracking-tight" %>
          </div>

          <div class="flex items-center gap-4">
            <% if authenticated? %>
              <%= link_to "Meus Projetos", projects_path,
                  class: "text-sm font-medium hidden sm:block transition-colors #{current_page?(projects_path) ? 'text-white font-semibold underline underline-offset-4 decoration-blue-300' : 'text-blue-200 hover:text-white'}" %>
              <span class="text-blue-500 hidden sm:block">|</span>
              <span class="text-sm text-blue-300 hidden sm:block"><%= Current.user.email_address %></span>
              <%= button_to "Sair", session_path, method: :delete,
                  class: "btn btn-sm bg-white/10 text-white border border-white/20 hover:bg-white/20 focus:ring-white/40" %>
            <% else %>
              <%= link_to "Entrar", new_session_path, class: "text-sm text-blue-200 hover:text-white font-medium transition-colors" %>
              <%= link_to "Criar conta", new_registration_path, class: "btn btn-sm bg-white text-blue-800 hover:bg-blue-50 font-semibold shadow-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice = flash[:notice] %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <p class="alert-success" role="alert">✓ <%= notice %></p>
      </div>
    <% end %>
    <% if alert = flash[:alert] %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <p class="alert-error" role="alert">⚠ <%= alert %></p>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>
