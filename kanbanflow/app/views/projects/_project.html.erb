<div class="card hover:shadow-md transition-shadow p-5 flex flex-col gap-3">
  <div class="flex items-start justify-between">
    <div class="flex items-center gap-2">
      <% if project.color.present? %>
        <span class="w-3.5 h-3.5 rounded-full flex-shrink-0" style="background-color: <%= project.color %>"></span>
      <% end %>
      <h2 class="font-semibold text-gray-900 text-lg leading-tight"><%= project.name %></h2>
    </div>
    <span class="text-xs text-gray-400"><%= project.tasks.size %> tarefas</span>
  </div>

  <% if project.description.present? %>
    <p class="text-sm text-gray-500 line-clamp-2"><%= project.description %></p>
  <% end %>

  <div class="flex items-center gap-2 mt-auto pt-2 border-t border-gray-100">
    <%= link_to "Ver board", project, class: "flex-1 text-center text-sm bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium py-1.5 rounded-md transition-colors" %>
    <%= link_to "Editar", edit_project_path(project), class: "text-sm text-gray-500 hover:text-gray-700 px-3 py-1.5 rounded-md hover:bg-gray-100 transition-colors" %>
  </div>
</div>
