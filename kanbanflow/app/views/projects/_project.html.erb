<div class="card hover:shadow-md transition-all p-5 flex flex-col gap-3 group">
  <div class="flex items-start justify-between">
    <div class="flex items-center gap-2.5">
      <% if project.color.present? %>
        <span class="w-4 h-4 rounded-full flex-shrink-0 shadow-sm" style="background-color: <%= project.color %>"></span>
      <% end %>
      <h2 class="font-bold text-gray-900 text-base leading-tight group-hover:text-blue-700 transition-colors"><%= project.name %></h2>
    </div>
    <span class="text-xs font-medium text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"><%= project.tasks.size %> tarefas</span>
  </div>

  <% if project.description.present? %>
    <p class="text-sm text-gray-500 line-clamp-2"><%= project.description %></p>
  <% end %>

  <div class="flex items-center gap-2 mt-auto pt-3 border-t border-gray-100">
    <%= link_to "Ver board", project, class: "flex-1 text-center text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition-colors shadow-sm" %>
    <%= link_to "Editar", edit_project_path(project), class: "text-sm text-gray-500 hover:text-gray-800 px-3 py-2 rounded-lg hover:bg-gray-100 transition-colors font-medium" %>
  </div>
</div>
