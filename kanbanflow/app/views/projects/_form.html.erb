<%= form_with model: project, class: "space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div class="alert-error">
      <p class="font-semibold mb-1">
        <%= pluralize(project.errors.count, "erro", "erros") %> impediram salvar o projeto:
      </p>
      <ul class="list-disc list-inside space-y-0.5">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome do projeto", class: "label" %>
    <%= f.text_field :name, placeholder: "Ex: KanbanFlow", class: "input" %>
  </div>

  <div>
    <%= f.label :description, "Descrição (opcional)", class: "label" %>
    <%= f.text_area :description, rows: 3, placeholder: "Sobre o que é este projeto?", class: "textarea" %>
  </div>

  <div>
    <%= f.label :color, "Cor do projeto", class: "label" %>
    <div class="flex gap-2 flex-wrap">
      <% Project::COLORS.each do |hex| %>
        <label class="relative cursor-pointer">
          <%= f.radio_button :color, hex, class: "sr-only peer" %>
          <span class="block w-8 h-8 rounded-full border-2 border-transparent peer-checked:border-gray-800 peer-checked:scale-110 transition-all"
                style="background-color: <%= hex %>"></span>
        </label>
      <% end %>
      <%# Opção "sem cor" %>
      <label class="relative cursor-pointer">
        <%= f.radio_button :color, "", class: "sr-only peer" %>
        <span class="block w-8 h-8 rounded-full border-2 border-gray-300 bg-white peer-checked:border-gray-800 transition-all flex items-center justify-center text-gray-400 text-xs">✕</span>
      </label>
    </div>
  </div>

  <div class="pt-2">
    <%= f.submit project.new_record? ? "Criar Projeto" : "Salvar Alterações", class: "btn btn-primary w-full" %>
  </div>
<% end %>
