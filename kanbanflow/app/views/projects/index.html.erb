<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Meus Projetos</h1>
  <%= link_to "Novo Projeto", new_project_path, class: "btn btn-primary" %>
</div>

<% if @projects.empty? %>
  <div class="card text-center py-20 text-gray-500">
    <p class="text-lg mb-4">Nenhum projeto ainda.</p>
    <%= link_to "Criar meu primeiro projeto →", new_project_path, class: "text-blue-600 hover:underline font-medium" %>
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @projects.each do |project| %>
      <%= render "project", project: project %>
    <% end %>
  </div>
<% end %>
