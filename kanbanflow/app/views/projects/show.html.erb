<div class="flex items-center justify-between mb-8">
  <div class="flex items-center gap-3">
    <% if @project.color.present? %>
      <span class="w-5 h-5 rounded-full flex-shrink-0" style="background-color: <%= @project.color %>"></span>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900"><%= @project.name %></h1>
  </div>
  <div class="flex gap-2">
    <%= link_to "Editar", edit_project_path(@project),
        class: "text-sm text-gray-600 border border-gray-300 hover:bg-gray-100 px-3 py-1.5 rounded-lg transition-colors" %>
    <%= button_to "Excluir", @project, method: :delete,
        data: { turbo_confirm: "Tem certeza? Todas as tarefas serão excluídas." },
        class: "text-sm text-red-600 border border-red-300 hover:bg-red-50 px-3 py-1.5 rounded-lg transition-colors" %>
  </div>
</div>

<% if @project.description.present? %>
  <p class="text-gray-600 mb-8"><%= @project.description %></p>
<% end %>

<%# Board Kanban — 3 colunas %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

  <% { "A Fazer" => :todo, "Em Andamento" => :in_progress, "Concluído" => :done }.each do |label, status_key| %>
    <div class="bg-white rounded-xl border border-gray-200 p-4 min-h-64">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-gray-700"><%= label %></h2>
        <span class="text-xs bg-gray-100 text-gray-500 rounded-full px-2 py-0.5">
          <%= @tasks_by_status[status_key].size %>
        </span>
      </div>

      <div class="space-y-2">
        <% @tasks_by_status[status_key].each do |task| %>
          <%= render "tasks/task", task: task %>
        <% end %>
      </div>

      <%= link_to "+ Adicionar tarefa", new_project_task_path(@project, status: status_key),
          class: "mt-4 block text-center text-sm text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 py-2 rounded-lg transition-colors" %>
    </div>
  <% end %>

</div>

<div class="mt-6">
  <%= link_to "← Meus Projetos", projects_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>
