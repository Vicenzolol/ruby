<%# Inscreve a view no canal deste projeto para receber Turbo Streams %>
<%= turbo_stream_from @project %>

<div class="flex items-center justify-between mb-8">
  <div class="flex items-center gap-3">
    <% if @project.color.present? %>
      <span class="w-5 h-5 rounded-full flex-shrink-0" style="background-color: <%= @project.color %>"></span>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900"><%= @project.name %></h1>
  </div>
  <div class="flex gap-2">
    <%= link_to "Editar", edit_project_path(@project), class: "btn btn-secondary btn-sm" %>
    <%= button_to "Excluir", @project, method: :delete,
        data: { turbo_confirm: "Tem certeza? Todas as tarefas serão excluídas." },
        class: "btn btn-danger btn-sm" %>
  </div>
</div>

<% if @project.description.present? %>
  <p class="text-gray-600 mb-8"><%= @project.description %></p>
<% end %>

<%# Board Kanban — 3 colunas com Turbo Frames e Streams %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6"
     data-controller="board"
     data-board-update-url-value="<%= update_task_status_project_path(@project) %>">

  <%
    column_meta = {
      "A Fazer"      => { key: :todo,        col_class: "kanban-column--todo",     badge: "bg-blue-100 text-blue-700",    text: "text-blue-700" },
      "Em Andamento" => { key: :in_progress, col_class: "kanban-column--progress", badge: "bg-amber-100 text-amber-700",  text: "text-amber-700" },
      "Concluído"    => { key: :done,        col_class: "kanban-column--done",     badge: "bg-emerald-100 text-emerald-700", text: "text-emerald-700" }
    }
  %>
  <% column_meta.each do |label, meta| %>
    <% status_key = meta[:key] %>
    <div class="kanban-column <%= meta[:col_class] %>"
         data-board-status-value="<%= status_key %>"
         data-board-target="column">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-widest <%= meta[:text] %>"><%= label %></h2>
        <span class="text-xs font-semibold rounded-full px-2 py-0.5 <%= meta[:badge] %>"
              id="<%= status_key %>-count">
          <%= @tasks_by_status[status_key].size %>
        </span>
      </div>

      <%# Lista de tarefas — alvo dos Turbo Streams (append/remove) %>
      <div id="<%= status_key %>-tasks"
           class="space-y-3 flex-1"
           data-board-target="taskList"
           data-status="<%= status_key %>">
        <% @tasks_by_status[status_key].each do |task| %>
          <%= render "tasks/task", task: task %>
        <% end %>
      </div>

      <%# Turbo Frame: form inline de nova tarefa por coluna %>
      <%= turbo_frame_tag "new_task_#{status_key}" do %>
        <%= link_to "+ Adicionar tarefa",
            new_project_task_path(@project, status: status_key),
            class: "block text-center text-sm font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 py-2 rounded-md transition-colors" %>
      <% end %>
    </div>
  <% end %>

</div>


<div class="mt-6">
  <%= link_to "← Meus Projetos", projects_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>
