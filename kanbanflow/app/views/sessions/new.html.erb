<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
  <div class="card max-w-md w-full p-8 space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 text-center">Entrar</h1>
      <p class="mt-2 text-center text-sm text-gray-500">
        Não tem conta?
        <%= link_to "Criar conta", new_registration_path, class: "text-blue-600 hover:text-blue-700 font-medium" %>
      </p>
    </div>

    <% if alert = flash[:alert] %>
      <p class="alert-error" id="alert"><%= alert %></p>
    <% end %>
    <% if notice = flash[:notice] %>
      <p class="alert-success" id="notice"><%= notice %></p>
    <% end %>

    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "E-mail", class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", placeholder: "seu@email.com",
            value: params[:email_address], class: "input" %>
      </div>

      <div>
        <%= form.label :password, "Senha", class: "label" %>
        <%= form.password_field :password, required: true,
            autocomplete: "current-password", placeholder: "Sua senha",
            maxlength: 72, class: "input" %>
      </div>

      <%= form.submit "Entrar", class: "btn btn-primary w-full" %>

      <p class="text-center text-sm">
        <%= link_to "Esqueci minha senha", new_password_path, class: "text-gray-500 hover:text-gray-700 underline" %>
      </p>
    <% end %>
  </div>
</div>
