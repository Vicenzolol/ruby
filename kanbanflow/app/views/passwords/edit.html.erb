<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
  <div class="card max-w-md w-full p-8 space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 text-center">Atualizar senha</h1>
      <p class="mt-2 text-center text-sm text-gray-500">Defina sua nova senha.</p>
    </div>

    <% if flash[:alert] %>
      <p class="alert-error" id="alert"><%= flash[:alert] %></p>
    <% end %>
    <% if flash[:alert_errors]&.any? %>
      <div class="alert-error" id="alert-errors">
        <ul class="list-disc list-inside space-y-0.5">
          <% flash[:alert_errors].each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, "Nova senha", class: "label" %>
        <%= form.password_field :password, required: true,
            autocomplete: "new-password", placeholder: "Digite a nova senha",
            maxlength: 72, class: "input" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirmar senha", class: "label" %>
        <%= form.password_field :password_confirmation, required: true,
            autocomplete: "new-password", placeholder: "Repita a nova senha",
            maxlength: 72, class: "input" %>
      </div>

      <%= form.submit "Salvar", class: "btn btn-primary w-full" %>
    <% end %>
  </div>
</div>
